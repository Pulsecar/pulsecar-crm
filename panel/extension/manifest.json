{
  "manifest_version": 3,
  "name": "Pulsecar — запчасти от поставщика",
  "short_name": "Pulsecar",
  "version": "1.7.2",
  "description": "Запчасти с сайтов поставщиков и Allegro — в заказ, выцену или на склад CRM Pulsecar. Фактуры в приход, чеки на кассе Novitus.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pulsecar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://panel.pulsecar.tech/*",
    "http://localhost/*",
    "https://*.intercars.eu/*",
    "https://*.intercars.com.pl/*",
    "https://*.intercars.pl/*",
    "https://*.hartphp.com.pl/*",
    "https://*.autopartner.com/*",
    "https://*.autopartner.pl/*",
    "https://*.apcat.eu/*",
    "https://*.inter-team.com.pl/*",
    "https://*.motoprofil.pl/*",
    "https://*.profiauto.pl/*",
    "https://*.profiauto.com/*",
    "https://*.gordon.com.pl/*",
    "https://*.motorol.pl/*",
    "https://*.rodon.pl/*",
    "https://*.arge.pl/*",
    "https://*.elit.pl/*",
    "https://*.autoland.pl/*",
    "https://allegro.pl/*",
    "https://*.allegro.pl/*",
    "http://127.0.0.1/*",
    "https://www.partslink24.com/*",
    "https://*.e-cat.intercars.eu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.intercars.eu/*",
        "https://*.intercars.com.pl/*",
        "https://*.intercars.pl/*",
        "https://*.hartphp.com.pl/*",
        "https://*.autopartner.com/*",
        "https://*.autopartner.pl/*",
        "https://*.apcat.eu/*",
        "https://*.inter-team.com.pl/*",
        "https://*.motoprofil.pl/*",
        "https://*.profiauto.pl/*",
        "https://*.profiauto.com/*",
        "https://*.gordon.com.pl/*",
        "https://*.motorol.pl/*",
        "https://*.rodon.pl/*",
        "https://*.arge.pl/*",
        "https://*.elit.pl/*",
        "https://*.autoland.pl/*",
        "https://allegro.pl/*",
        "https://*.allegro.pl/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.intercars.eu/*",
        "https://*.intercars.com.pl/*",
        "https://*.intercars.pl/*",
        "https://*.hartphp.com.pl/*",
        "https://*.autopartner.com/*",
        "https://*.autopartner.pl/*",
        "https://*.apcat.eu/*",
        "https://*.inter-team.com.pl/*",
        "https://*.motoprofil.pl/*",
        "https://*.profiauto.pl/*",
        "https://*.profiauto.com/*",
        "https://*.gordon.com.pl/*",
        "https://*.motorol.pl/*",
        "https://*.rodon.pl/*",
        "https://*.arge.pl/*",
        "https://*.elit.pl/*",
        "https://*.autoland.pl/*",
        "https://allegro.pl/*",
        "https://*.allegro.pl/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://panel.pulsecar.tech/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
