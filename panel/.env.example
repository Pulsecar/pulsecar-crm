# Скопируйте в .env и заполните

# длинная случайная строка (например: openssl rand -hex 32)
SESSION_SECRET=
PUBLIC_URL=https://panel.pulsecar.tech

# первый вход в панель /admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# SMS: токен SMSAPI вводится в Настройки → Интеграции. Пока его нет — коды входа пишутся в лог сервера.

# тестовый вход для проверяющих App Store / Google Play (номер + постоянный код, без SMS)
REVIEW_PHONE=+48500000000
REVIEW_CODE=

# ── Pulse Points ──
RATE_START=0.5          # баллов за 1 zł на уровне Start
SILVER_FROM=3000        # Silver — от 3000 zł оплат за 12 месяцев
RATE_SILVER=0.6
GOLD_FROM=8000          # Gold — от 8000 zł
RATE_GOLD=0.75
POINT_VALUE_PLN=0.1     # 1 балл = 0,10 zł скидки
MIN_REDEEM=100          # списание от 100 баллов
MAX_REDEEM_SHARE=0.3    # баллами можно оплатить до 30% заказа
WELCOME_BONUS=50        # бонус за регистрацию
AUTO_EARN_FROM_CRM=1    # начислять баллы по выгрузке CRM за неотсканированные заказы

# ── Интеграции ──
# Токены Inter Cars, Fakturownia, SMSAPI, почты, Tpay, Telegram и др. вводятся в панели:
# Настройки → Интеграции (хранятся в базе на сервере). Значения ниже — только запасной вариант.
SMS_ON_STATUS=1
# общий вход для панели бота на marketing.pulsecar.tech (cookie CRM видна на поддоменах)
COOKIE_DOMAIN=.pulsecar.tech
