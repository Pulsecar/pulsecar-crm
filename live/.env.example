# Pulsecar Live — скопируйте в .env и заполните.

# Адрес, который получают клиенты (отдельный поддомен pulsecar.tech)
PUBLIC_URL=https://live.pulsecar.tech

# Адрес CRM — только ему разрешено встраивать модуль (iframe) и получать сообщения от него
CRM_ORIGIN=https://panel.pulsecar.tech

# Ключ для бэкенда CRM (заголовок Authorization: Bearer ...). Сгенерировать: openssl rand -hex 32
# Хранится ТОЛЬКО на сервере CRM, во фронтенд не попадает.
CRM_API_KEY=

# Подпись сессий. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Запасной вход в панель напрямую (https://live.pulsecar.tech/admin), минимум 10 символов
ADMIN_PASSWORD=

# Порт модуля на 127.0.0.1 (nginx проксирует на него)
APP_PORT=3010

# Максимальный срок одной ссылки, дней
MAX_LINK_DAYS=90

# Cookie: Lax подходит, когда CRM и модуль на одном домене (panel.pulsecar.tech + live.pulsecar.tech).
# Если CRM на другом домене — поставьте None (нужен HTTPS).
COOKIE_SAMESITE=Lax
