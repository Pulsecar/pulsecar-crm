# ===== ИИ-запчастист Pulsecar — переменные окружения =====
# Ключи сервисов (Claude, Inter Cars и т.д.) вводятся в разделе «Интеграции»
# и хранятся в базе в зашифрованном виде. Здесь — только служебные настройки.

# Порт сервиса
PORT=3200

# Путь к файлу базы (SQLite). В Docker — смонтированный том.
DB_PATH=./data/ai-parts.db

# Мастер-ключ шифрования ключей интеграций (32 байта в base64).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# Общий секрет CRM ↔ сервис для подписи токенов (HMAC-SHA256).
# Тот же секрет кладётся в CRM. Сгенерировать так же, как MASTER_KEY.
CRM_SHARED_SECRET=

# Адреса CRM, с которых разрешено открывать виджет (через запятую), напр. https://crm.pulsecar.pl
CORS_ORIGINS=

# (необязательно) ключ Claude по умолчанию, если в «Интеграциях» не задан
ANTHROPIC_API_KEY=
