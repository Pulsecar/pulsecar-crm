{
  "expo": {
    "name": "Pulsecar",
    "slug": "pulsecar",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.pulsecar.app",
      "buildNumber": "2",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "tg",
          "sms",
          "tel",
          "mailto"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "pl.pulsecar.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#101113",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Pulsecar",
      "backgroundColor": "#101113",
      "themeColor": "#101113",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#101113",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "pulsecar",
    "backgroundColor": "#101113",
    "description": "Warsztat samochodowy Pulsecar — Warszawa Bielany, ul. Arkuszowa 176",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
